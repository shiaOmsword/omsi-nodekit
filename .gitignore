# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Poetry
poetry.toml

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# PyInstaller
*.spec

# Environment files / secrets
.env
.env.*
!.env.example

# Logs
logs/
!frontend/src/features/logs/
!frontend/src/features/logs/**
*.log

# Local data
data/
tmp/
temp/
.cache/

# IDE / editors
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.pyre/
.cache/

# Rich / terminal recordings if you ever use them

# Local launcher files
local_settings.py
settings.local.py

# Windows shortcuts / local launch files
*.lnk

# Nodekit local runtime / frontend
node_modules/
frontend/dist/
backend/config/*.local.yaml
*.db
*.db-wal
*.db-shm
*.pem
*.key
playwright-report/
test-results/
*.tsbuildinfo

# Extra local/production secrets (patterns are a safety net, not secret scanning)
.ssh/
known_hosts
authorized_keys
id_rsa*
id_ecdsa*
id_ed25519*
*.p8
*.p12
*.pfx
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db-journal
*.ovpn
*.age
