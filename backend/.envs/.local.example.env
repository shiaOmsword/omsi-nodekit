# Copy to .local.env. Select another file with NODEKIT_ENVIRONMENT=staging in your shell.
NODEKIT_DATA_DIR=./data
NODEKIT_FRONTEND_DIR=../frontend/dist
NODEKIT_LOG_LEVEL=INFO

# Nested settings use double underscores. These are the defaults; uncomment to override.
# NODEKIT_SERVER__PORT=8765
# NODEKIT_SERVER__FRONTEND_DEV_PORT=5173
# NODEKIT_SSH__OPERATION_TIMEOUT=1200
# NODEKIT_SSH__CONNECT_TIMEOUT=10
# NODEKIT_DEPLOYMENT__REMOTE_ROOT=/opt/omsi-nodekit
# NODEKIT_DEPLOYMENT__UNIT_DIRECTORY=/etc/systemd/system
# NODEKIT_DEPLOYMENT__PULL_TIMEOUT=600
# NODEKIT_LIMITS__BACKUP_BYTES=67108864
# NODEKIT_LIMITS__CONFIG_BYTES=65536
# NODEKIT_LIMITS__JOB_HISTORY=50
# NODEKIT_LIMITS__MAX_TUNNELS=12
